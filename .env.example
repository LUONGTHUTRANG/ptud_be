# Firebase Configuration
# Lưu file này thành .env trong thư mục backend

# Option 1: Dùng Service Account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json

# Option 2: Dùng Environment Variables (nếu không muốn dùng file)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBA...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=dormitory_db
DB_PORT=3306

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key

# Email Service (nếu dùng)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
